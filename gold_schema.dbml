Table dim_products {
  product_id int [pk]
  product_name varchar
  created_at datetime
}

Table dim_campaign {
  campaign_key varchar [pk, note: 'surrogate key: hash(utm_source, utm_campaign, utm_content); one row is the (direct/none) sentinel']
  utm_source varchar
  utm_campaign varchar
  utm_content varchar
  is_direct_none boolean
}

Table dim_users {
  user_id int [pk]
  first_session_at datetime
  last_session_at datetime
  cohort_month date [note: 'truncated month of first_session_at']
  first_touch_campaign_key varchar [ref: > dim_campaign.campaign_key]
  last_touch_campaign_key varchar [ref: > dim_campaign.campaign_key]
  is_repeat_session_customer boolean
  is_repeat_order_customer boolean
  lifetime_orders int
  lifetime_revenue_usd decimal
}

Table dim_date {
  date_day date [pk]
  year int
  month int
  month_name varchar
  year_month varchar [note: 'join key for cohort bucketing']
  day_of_week int
  is_weekend boolean

  Note: 'Gap-fill grain for fct_daily_sales only. NOT the Power BI calendar table — Power BI keeps its own fxCalendar-based Date Table for DAX time intelligence.'
}

Table fct_pageviews {
  website_pageview_id int [pk]
  website_session_id int [ref: > fct_sessions.website_session_id]
  created_at datetime
  pageview_url_clean varchar [note: 'query string + trailing slash stripped']
  funnel_step_name varchar [note: 'homepage | product | cart | checkout | thank_you | null']
  funnel_step_order int
}

Table fct_sessions {
  website_session_id int [pk]
  user_id int [ref: > dim_users.user_id]
  campaign_key varchar [ref: > dim_campaign.campaign_key]
  device_type varchar
  created_at datetime
  is_repeat_session boolean
  reached_homepage boolean
  reached_product boolean
  reached_cart boolean
  reached_checkout boolean
  reached_thank_you boolean
  pageview_count int
  order_count int
  revenue_usd decimal
  cogs_usd decimal
  gross_profit_usd decimal [note: 'revenue_usd - cogs_usd; the ROI-proxy metric']
}

Table fct_orders {
  order_id int [pk]
  website_session_id int [ref: > fct_sessions.website_session_id]
  user_id int [ref: > dim_users.user_id]
  campaign_key varchar [ref: > dim_campaign.campaign_key, note: 'denormalized from originating session']
  device_type varchar [note: 'denormalized from originating session']
  primary_product_id int [ref: > dim_products.product_id]
  created_at datetime
  items_purchased int
  price_usd decimal
  cogs_usd decimal
  gross_profit_usd decimal
  refund_amount_usd decimal [note: 'rolled up from order_item_refunds']
  net_revenue_usd decimal [note: 'price_usd - refund_amount_usd']
}

Table fct_order_items {
  order_item_id int [pk]
  order_id int [ref: > fct_orders.order_id]
  product_id int [ref: > dim_products.product_id]
  created_at datetime
  price_usd decimal
  cogs_usd decimal
  refund_amount_usd decimal
  is_refunded boolean
  net_revenue_usd decimal [note: 'price_usd - refund_amount_usd; drives net revenue by product']
}

Table fct_daily_sales {
  date_day date [pk, ref: > dim_date.date_day]
  session_count int
  order_count int
  revenue_usd decimal
  refund_amount_usd decimal
  net_revenue_usd decimal
  gross_profit_usd decimal
}
